{
  "globalHeaders": {
    "Content-Security-Policy": "default-src 'self'; script-src 'self' https://unpkg.com; style-src 'self' https://unpkg.com; img-src 'self' data: https://*.basemaps.cartocdn.com https://unpkg.com; connect-src 'self' https://honeypotpublicdata.blob.core.windows.net https://aianalysis-hmhudebecwhebrhv.westus2-01.azurewebsites.net; font-src 'self'; object-src 'none'; base-uri 'self'; frame-ancestors 'none'",
    "X-Content-Type-Options": "nosniff",
    "Referrer-Policy": "strict-origin-when-cross-origin",
    "X-Frame-Options": "DENY",
    "Permissions-Policy": "geolocation=(), microphone=(), camera=()",
    "Strict-Transport-Security": "max-age=31536000"
  },
  "responseOverrides": {
    "404": { "rewrite": "/404.html", "statusCode": 404 }
  },
  "routes": [
    { "route": "/", "headers": { "Cache-Control": "no-cache" } },
    { "route": "/index.html", "headers": { "Cache-Control": "no-cache" } },
    { "route": "/css/main.css", "headers": { "Cache-Control": "no-cache" } },
    { "route": "/css/404.css", "headers": { "Cache-Control": "no-cache" } },
    { "route": "/js/main.js", "headers": { "Cache-Control": "no-cache" } },
    { "route": "/og-image.png", "headers": { "Cache-Control": "public, max-age=604800" } },
    { "route": "/favicon.svg", "headers": { "Cache-Control": "public, max-age=604800" } },
    { "route": "/favicon.ico", "headers": { "Cache-Control": "public, max-age=604800" } }
  ],
  "mimeTypes": {
    ".svg": "image/svg+xml",
    ".json": "application/json",
    ".ico": "image/x-icon"
  }
}
