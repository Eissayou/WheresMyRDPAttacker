# Terraform
terraform/.terraform/
terraform/.terraform.lock.hcl
terraform/*.tfstate
terraform/*.tfstate.*
terraform/*.tfvars
terraform/*.auto.tfvars
terraform/crash.log
terraform/crash.*.log
terraform/override.tf
terraform/override.tf.json
terraform/*_override.tf
terraform/*_override.tf.json

# Personal notes
TERRAFORM_LEARNING_PLAN.md
STUDY_GUIDE.md

# Azure Functions
functions/local.settings.json
functions/.python_packages/
functions/__pycache__/
functions/.venv/

# Editor / tooling
.vscode/
.claude/
.DS_Store

# Defensive: never commit state, tfvars, or env files from ANY directory
*.tfstate
*.tfstate.*
*.tfvars
*.auto.tfvars
.terraform/
.env
*.env

# Azure Functions local test dir (referenced by .funcignore)
functions/test/
